# Template only. Add values in Vercel project settings for Production.
# Never put real secrets in this tracked template or NEXT_PUBLIC_ variables.
DATABASE_PROVIDER=postgresql
DATABASE_URL=
DIRECT_URL=
# Neon provides DATABASE_URL_UNPOOLED; copy that value into DIRECT_URL in Vercel.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://geez-squad.vercel.app
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
# Free Gmail SMTP: authorize an existing mailbox with a Gmail app password.
# EMAIL_FROM must match SMTP_USER; a purchased domain is not required.
EMAIL_DELIVERY=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Set EMAIL_FROM above to the same mailbox (optionally Geez Squad <address>).
# resend remains supported; test is restricted to operator testing without mail.
LOG_LEVEL=info
CRON_SECRET=
# Keep billing disabled until paid access and live payment tests are complete.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
