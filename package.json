{
  "name": "geez-squad",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "node scripts/prepare-assets.mjs && prisma generate && next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:api": "node scripts/test-api.mjs",
    "test:studio": "node scripts/test-studio-operations.mjs",
    "test:capacity": "node scripts/test-class-capacity.mjs",
    "test:media": "node scripts/test-media-capacity.mjs",
    "test:coaching": "node scripts/test-coaching-phase.mjs",
    "test:next-phase": "node scripts/test-next-phase.mjs",
    "pose:evaluate": "node scripts/evaluate-pose.mjs",
    "db:coaching:postgres": "node scripts/rehearse-coaching-postgres.mjs",
    "test:e2e": "playwright test",
    "test:email-disabled": "node scripts/test-email-modes.mjs disabled",
    "test:signup": "node scripts/test-email-modes.mjs test",
    "setup": "node scripts/init-local.mjs && prisma generate && prisma migrate deploy && node scripts/prepare-assets.mjs",
    "db:setup": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:postgres:generate": "node scripts/postgres.mjs generate",
    "db:postgres:migrate": "node scripts/postgres.mjs migrate",
    "db:postgres:check": "node scripts/postgres.mjs check",
    "build:vercel": "node scripts/production-check.mjs && node scripts/postgres.mjs check && node scripts/postgres.mjs generate && node scripts/prepare-assets.mjs && next build",
    "production:check": "node scripts/production-check.mjs",
    "assets": "node scripts/prepare-assets.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,mjs}\" \"tests/**/*.ts\" \"scripts/*.mjs\" \"*.{json,ts,mjs}\" public/pose-worker.js",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,mjs}\" \"tests/**/*.ts\" \"scripts/*.mjs\" \"*.{json,ts,mjs}\" public/pose-worker.js",
    "test:a11y": "node scripts/check-accessibility.mjs",
    "mail:verify": "node scripts/verify-mail.mjs",
    "db:members:check": "node scripts/backfill-member-accounts.mjs",
    "db:members:backfill": "node scripts/backfill-member-accounts.mjs --apply",
    "test:roles": "node scripts/test-studio-roles.mjs",
    "db:roles:check": "node scripts/backfill-studio-roles.mjs",
    "db:roles:backfill": "node scripts/backfill-studio-roles.mjs --apply",
    "db:roles:rehearse": "node scripts/rehearse-role-migration.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.32",
    "@prisma/client": "6.19.3",
    "better-auth": "1.7.7",
    "livekit-client": "2.22.3",
    "livekit-server-sdk": "2.19.1",
    "lucide-react": "1.52.0",
    "next": "16.4.2",
    "nodemailer": "^10.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "stripe": "23.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.19.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.9",
    "prisma": "6.19.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
